DISCORD_TOKEN=PUT_YOUR_DISCORD_BOT_TOKEN_HERE
MINECRAFT_CHANNEL_ID=PUT_YOUR_MINECRAFT_CHAT_CHANNEL_ID_HERE
BOT_LOG_CHANNEL_ID=PUT_YOUR_BOT_LOG_CHANNEL_ID_HERE

MC_HOST=nexusforever.aternos.me
MC_PORT=15629
MC_VERSION=26.3
MC_USERNAME=MCLogger
MC_PASSWORD=PUT_YOUR_EASYAUTH_PASSWORD_HERE
MC_RECONNECT_DELAY=30
MC_RECONNECT_MAX_ATTEMPTS=400

# Paste your ATERNOS_SESSION cookie value from browser DevTools (no quotes)
ATERNOS_SESSION=PUT_YOUR_ATERNOS_SESSION_COOKIE_HERE
ATERNOS_TOKEN=

# Optional: comma-separated Discord user IDs allowed to run /restart (Owner & Admins work automatically)
ADMIN_USER_IDS=

# Optional: Silly Development (Pterodactyl) Panel API for container-level /restart
PANEL_URL=https://panel.sillydev.co.uk
PANEL_API_KEY=
PANEL_SERVER_ID=
